# ============================================================
# shebao-qa-agent 环境变量模板
# 复制本文件为 .env，填入你的 API Key（只填一个平台即可）
# .env 已被 .gitignore 拦截，永不入库
# ============================================================

# 选择平台：zhipu（智谱 GLM）| deepseek
# 建议 zhipu：agent.py 的 PROMPT 身份条款按智谱 GLM 声明，两边保持一致
PROVIDER=zhipu

# ---- 智谱 GLM（新用户有免费额度）----
# 开通：https://open.bigmodel.cn/ -> 用户中心 -> API Keys
ZHIPU_API_KEY=sk-你的智谱key

# ---- DeepSeek（备选，充值即用）----
# 注册/充值：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-你的deepseek-key
